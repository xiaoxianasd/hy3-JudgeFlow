# Hy3 self-hosted OpenAI-compatible endpoint (vLLM/SGLang)
HY3_BASE_URL=http://127.0.0.1:8000/v1
# Tencent Cloud TokenHub Guangzhou alternative:
# HY3_BASE_URL=https://tokenhub.tencentmaas.com/v1
HY3_API_KEY=EMPTY
HY3_MODEL=hy3
HY3_TIMEOUT_SECONDS=180
HY3_MAX_TOKENS=8192
# Keep solution generation concise enough to leave room for the final JSON.
HY3_SOLVE_REASONING_EFFORT=low
# Review-stage per-call budget (specialist/supervisor). Reasoning models
# can exhaust small budgets on reasoning alone (finish_reason=length), so keep
# this >= 8192 for supervisor-mode review.
HY3_REVIEW_MAX_TOKENS=12288
HY3_REVIEW_REASONING_EFFORT=high
HY3_TEMPERATURE=0.9
HY3_TOP_P=1.0

# Web/API. Keep WEB_API_KEY empty for local development only.
WEB_HOST=127.0.0.1
WEB_PORT=8765
WEB_API_KEY=
WEB_ALLOWED_ORIGINS=
WEB_TRUST_PROXY_HEADERS=false
WEB_FORWARDED_ALLOW_IPS=127.0.0.1
WEB_RATE_LIMIT_PER_MINUTE=20
WEB_MAX_REQUEST_BYTES=65536
WEB_JOB_WORKERS=1
WEB_JOB_QUEUE_SIZE=8
WEB_JOB_TTL_SECONDS=3600
WEB_MAX_STORED_JOBS=500
WEB_HTTP_CONCURRENCY=100
WEB_EXPOSE_DOCS=true
WEB_LOG_LEVEL=info

# Durable queue. Memory is for local demos/tests only; production must use mysql.
QUEUE_BACKEND=memory
# DATABASE_URL=mysql+pymysql://tracejudge:CHANGE_ME@127.0.0.1:3306/tracejudge?charset=utf8mb4
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_RECYCLE_SECONDS=1800
JOB_POLL_INTERVAL_SECONDS=0.5
JOB_LEASE_SECONDS=900
JOB_HEARTBEAT_SECONDS=15
JOB_MAX_ATTEMPTS=3
JOB_RETENTION_SECONDS=604800

# Code sandbox. Local is development-only and is rejected when APP_ENV=production.
APP_ENV=development
SANDBOX_BACKEND=local
ALLOW_UNSAFE_LOCAL_EXECUTION=true
SANDBOX_DOCKER_IMAGE=hy3-process-sandbox:py3.12
SANDBOX_MEMORY_MB=256
SANDBOX_CPUS=1.0
SANDBOX_PIDS_LIMIT=32
SANDBOX_MAX_INPUT_BYTES=2097152
SANDBOX_MAX_OUTPUT_BYTES=1048576
SANDBOX_MAX_CODE_BYTES=65536
SANDBOX_MAX_TESTS=512
SANDBOX_MAX_VALUE_BYTES=65536
