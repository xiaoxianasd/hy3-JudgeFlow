# TraceJudge production Web/API. Copy to .env and replace every placeholder.
APP_ENV=production

# Bind to loopback and publish through a TLS reverse proxy.
WEB_HOST=127.0.0.1
WEB_PORT=8765
WEB_API_KEY=REPLACE_WITH_A_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS
WEB_ALLOWED_ORIGINS=https://tracejudge.example.com
WEB_TRUST_PROXY_HEADERS=true
WEB_FORWARDED_ALLOW_IPS=127.0.0.1
WEB_RATE_LIMIT_PER_MINUTE=20
WEB_MAX_REQUEST_BYTES=65536
WEB_JOB_WORKERS=2
WEB_JOB_QUEUE_SIZE=8
WEB_JOB_TTL_SECONDS=3600
WEB_MAX_STORED_JOBS=500
WEB_HTTP_CONCURRENCY=100
WEB_EXPOSE_DOCS=false
WEB_LOG_LEVEL=info

# MySQL durable task queue.
QUEUE_BACKEND=mysql
DATABASE_URL=mysql+pymysql://tracejudge:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:3306/tracejudge?charset=utf8mb4&connect_timeout=5
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_RECYCLE_SECONDS=1800
JOB_POLL_INTERVAL_SECONDS=0.5
JOB_LEASE_SECONDS=900
JOB_HEARTBEAT_SECONDS=15
JOB_MAX_ATTEMPTS=2
JOB_RETENTION_SECONDS=604800

# Hy3 upstream. Never reuse HY3_API_KEY as WEB_API_KEY.
HY3_BASE_URL=https://tokenhub.tencentmaas.com/v1
HY3_API_KEY=REPLACE_WITH_TENCENT_TOKENHUB_KEY
HY3_MODEL=hy3
HY3_TIMEOUT_SECONDS=180
HY3_MAX_TOKENS=8192
HY3_TEMPERATURE=0.9
HY3_TOP_P=1.0

# Production candidate-code sandbox.
SANDBOX_BACKEND=docker
ALLOW_UNSAFE_LOCAL_EXECUTION=false
SANDBOX_DOCKER_IMAGE=hy3-process-sandbox:py3.12
SANDBOX_MEMORY_MB=256
SANDBOX_CPUS=1.0
SANDBOX_PIDS_LIMIT=32
SANDBOX_MAX_INPUT_BYTES=2097152
SANDBOX_MAX_OUTPUT_BYTES=1048576
SANDBOX_MAX_CODE_BYTES=65536
SANDBOX_MAX_TESTS=512
SANDBOX_MAX_VALUE_BYTES=65536
